# -----------------------------------------------------------------------------
# YFS Archive API - example configuration
#
# Copy to .env and edit:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# Every variable is optional except DATABASE_URL, ARCHIVE_TEMP_DIR and
# SELF_API_TOKEN.
# Durations use Go syntax: 500ms, 30s, 5m, 1h.
# -----------------------------------------------------------------------------

# --- Application -------------------------------------------------------------
APP_ENV=development

# --- HTTP server --------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s
# Public origin used to build absolute download_url values, e.g.
# https://archive.example.com (no trailing path). Empty = relative URLs.
SERVER_PUBLIC_BASE_URL=
# Shared secret (required). Callers of POST /internal/archives must send it
# in the X-API-Token header. Generate one with: openssl rand -hex 32
SELF_API_TOKEN=change-me

# --- PostgreSQL (required) ---------------------------------------------------
# Use a role granted SELECT only on folders, files, file_versions and servers.
# This service never writes to the database or changes its schema.
DATABASE_URL=postgres://archive_readonly:change-me@localhost:5432/yfs
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL: debug | info | warn | error
# LOG_OUTPUT: stdout | stderr | file   (LOG_FILE is required for "file")
LOG_LEVEL=info
LOG_OUTPUT=stdout
LOG_FILE=./logs/archive-service.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# --- Archives (ARCHIVE_TEMP_DIR is required) ---------------------------------
ARCHIVE_TEMP_DIR=./archives
ARCHIVE_MAX_SIZE_BYTES=4294967296
ARCHIVE_EXPIRY=1h
ARCHIVE_WORKERS=4
ARCHIVE_QUEUE_SIZE=100
ARCHIVE_CLEANUP_INTERVAL=10m
# Reserved for a future parallel fetcher; files are currently fetched
# sequentially within each job.
ARCHIVE_FILE_CONCURRENCY=4

# --- Storage servers ---------------------------------------------------------
# Time to wait for a storage server's response headers (not the whole body).
STORAGE_REQUEST_TIMEOUT=30s
# Storage server addresses and API keys are read from the `servers` table at
# startup - there is nothing else to configure here.
